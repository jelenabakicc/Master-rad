<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Spinner
        android:id="@+id/spinner_algorithm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>

    <!-- Array Length Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/array_length"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/edit_array_length"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="number"
            android:hint="10"
            android:maxLength="3"/>

        <Button
            android:id="@+id/btn_generate_random"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/generate_random"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <!-- Custom Array Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/edit_custom_array"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/custom_array"
            android:inputType="text"/>

        <Button
            android:id="@+id/btn_set_array"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_array"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <com.example.vizualizatorsortiranja.visualization.ArrayBarView
        android:id="@+id/array_bar_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp"/>

    <!-- Key Value and Comparison Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/text_key_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/text_compare_values"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- Speed Control -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speed"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp"/>

        <SeekBar
            android:id="@+id/seekbar_speed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="50"/>

        <TextView
            android:id="@+id/text_speed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1x"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:minWidth="40dp"
            android:gravity="center"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/start_sort"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_pause"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pause_sort"
            android:layout_marginStart="8dp"/>

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/reset_sort"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

</LinearLayout>
